# ===========================================
# LOST & FOUND API - Environment Variables
# ===========================================
# Copy this file to .env and fill with your actual credentials
# NEVER commit .env file to git!

# Application Settings
NODE_ENV=development
PORT=3000
API_PREFIX=/api
CORS_ORIGINS="http://localhost:19006,http://localhost:3000"

# Development Mode (Skip Email Verification)
# Set to "true" to skip email verification in development
# Users will be auto-verified on registration
SKIP_EMAIL_VERIFICATION=true

# App URL (used for email links, public assets)
APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:19006

# ===========================================
# DATABASE - Supabase PostgreSQL
# ===========================================
# Runtime: Supavisor session pooler (port 5432) is recommended for Render.
DATABASE_URL="postgresql://prisma.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full"
# Prisma CLI/migrations: use direct URL when IPv6 is available.
DIRECT_URL="postgresql://prisma:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=verify-full"

# Supabase Server/Auth and Storage
# URL, publishable key, and JWKS URL are safe to use in clients.
# SUPABASE_SECRET_KEY is server-only and must never be exposed to clients.
SUPABASE_URL="https://nbjalqpohrkooxlnrzof.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_fpv2xfY1MbPwGOVSC_BWzQ_Nf9yH9yK"
SUPABASE_SECRET_KEY="sb_secret_your-server-secret-key"
SUPABASE_JWKS_URL="https://nbjalqpohrkooxlnrzof.supabase.co/auth/v1/.well-known/jwks.json"
SUPABASE_STORAGE_BUCKET="item-images"

# ===========================================
# JWT AUTHENTICATION
# ===========================================
# Generate strong secrets: https://generate-secret.now.sh/32
JWT_SECRET="your-super-secret-jwt-key-here-min-32-characters"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-refresh-token-secret-here-min-32-characters"
JWT_REFRESH_EXPIRES_IN="30d"

# ===========================================
# REDIS (Optional - for caching)
# ===========================================
REDIS_URL="redis://localhost:6379"

# ===========================================
# EMAIL OTP - SMTP
# ===========================================
# Gmail: enable 2-Step Verification and use a 16-character App Password.
# Port 587 uses STARTTLS (SMTP_SECURE=false); port 465 uses TLS immediately.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-account@gmail.com"
SMTP_PASS="your-16-character-app-password"
SMTP_FROM="Lost & Found <your-account@gmail.com>"

# ===========================================
# GOOGLE OAUTH AUTHENTICATION
# ===========================================
# Get credentials from: https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID
# 2. Add authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret

# ===========================================
# FIREBASE ADMIN SDK
# ===========================================
# Local option: download the service-account JSON and set its path.
FIREBASE_CONFIG_PATH=""

# Render option: set these 3 variables and leave FIREBASE_CONFIG_PATH empty.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Keep literal \n sequences when entering this as one environment variable.
FIREBASE_PRIVATE_KEY=""

# Alternative Render option: paste the complete service-account JSON on one line.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# ===========================================
# LANGCHAIN / GOOGLE GEMINI
# ===========================================
GOOGLE_API_KEY="your-google-ai-studio-key"
AI_MODEL="gemini-2.5-flash"
