# ===========================================
# LOST & FOUND API - Environment Variables
# ===========================================
# Copy this file to .env and fill with your actual credentials
# NEVER commit .env file to git!

# Application Settings
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Development Mode (Skip Email Verification)
# Set to "true" to skip email verification in development
# Users will be auto-verified on registration
SKIP_EMAIL_VERIFICATION=true

# App URL (used for email links, public assets)
APP_URL=http://localhost:3000

# ===========================================
# DATABASE - Neon PostgreSQL
# ===========================================
# Get your connection string from: https://console.neon.tech
# Format: postgresql://username:password@host.region.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://username:password@your-host.neon.tech/dbname?sslmode=require"

# ===========================================
# JWT AUTHENTICATION
# ===========================================
# Generate strong secrets: https://generate-secret.now.sh/32
JWT_SECRET="your-super-secret-jwt-key-here-min-32-characters"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-refresh-token-secret-here-min-32-characters"
JWT_REFRESH_EXPIRES_IN="30d"

# ===========================================
# REDIS (Optional - for caching)
# ===========================================
REDIS_URL="redis://localhost:6379"

# ===========================================
# EMAIL CONFIGURATION (SMTP)
# ===========================================

# Gmail SMTP (Recommended for Production)
# Setup Guide:
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords
#    - Select "Mail" and "Other (Custom name)"
#    - Copy the 16-character password
# 3. Use your Gmail and App Password below
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password"

# ALTERNATIVE: Mailtrap (For Development/Testing Only)
# Sign up at: https://mailtrap.io
# Get credentials from: Email Testing > Inboxes > SMTP Settings
# SMTP_HOST="sandbox.smtp.mailtrap.io"
# SMTP_PORT=2525
# SMTP_SECURE=false
# SMTP_USER="your-mailtrap-username"
# SMTP_PASS="your-mailtrap-password"

# OPTION 3: SendGrid (Production Alternative)
# Get API key from: https://app.sendgrid.com/settings/api_keys
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="apikey"
# SMTP_PASS="your-sendgrid-api-key"

# Email Sender Information
SMTP_FROM_EMAIL="noreply@lostandfound.com"
SMTP_FROM_NAME="Lost & Found Team"

# ===========================================
# GOOGLE OAUTH AUTHENTICATION
# ===========================================
# Get credentials from: https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID
# 2. Add authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"
