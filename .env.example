# ===========================================
# LOST & FOUND API - Environment Variables
# ===========================================
# Copy this file to .env and fill with your actual credentials
# NEVER commit .env file to git!

# Application Settings
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Development Mode (Skip Email Verification)
# Set to "true" to skip email verification in development
# Users will be auto-verified on registration
SKIP_EMAIL_VERIFICATION=true

# App URL (used for email links, public assets)
APP_URL=http://localhost:3000

# ===========================================
# DATABASE - Neon PostgreSQL
# ===========================================
# Get your connection string from: https://console.neon.tech
# Format: postgresql://username:password@host.region.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://username:password@your-host.neon.tech/dbname?sslmode=require"

# ===========================================
# JWT AUTHENTICATION
# ===========================================
# Generate strong secrets: https://generate-secret.now.sh/32
JWT_SECRET="your-super-secret-jwt-key-here-min-32-characters"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-refresh-token-secret-here-min-32-characters"
JWT_REFRESH_EXPIRES_IN="30d"

# ===========================================
# REDIS (Optional - for caching)
# ===========================================
REDIS_URL="redis://localhost:6379"

# ===========================================
# EMAIL CONFIGURATION (Resend)
# ===========================================
# Resend - Modern Email API (Recommended)
# Get your API key from: https://resend.com/api-keys
#
# Setup Guide:
# 1. Sign up at https://resend.com
# 2. Create an API key
# 3. Add your domain (optional, for custom sender)
# 4. Use the API key below

RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Email Sender (use your verified domain or default Resend sender)
# Default: onboarding@resend.dev (for testing)
# Custom: noreply@yourdomain.com (requires domain verification)
EMAIL_FROM="Lost & Found <onboarding@resend.dev>"

# ===========================================
# GOOGLE OAUTH AUTHENTICATION
# ===========================================
# Get credentials from: https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID
# 2. Add authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret

# ===========================================
# FIREBASE ADMIN SDK
# ===========================================
# Local development (file path):
# FIREBASE_CONFIG_PATH="firebase/your-service-account.json"
#
# Render/Production (recommended):
# Put full JSON into FIREBASE_SERVICE_ACCOUNT_JSON
# or base64 JSON into FIREBASE_SERVICE_ACCOUNT_BASE64
FIREBASE_CONFIG_PATH="firebase/your-service-account.json"
FIREBASE_SERVICE_ACCOUNT_JSON=""
FIREBASE_SERVICE_ACCOUNT_BASE64=""
