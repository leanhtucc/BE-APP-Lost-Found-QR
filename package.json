{
  "name": "goalbe",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:phase4": "tsx watch src/phase4-test-server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json && npm run copy-templates",
    "copy-templates": "node -e \"const fs=require('fs');const path=require('path');const src='src/templates';const dest='dist/templates';fs.cpSync(src,dest,{recursive:true});console.log('Templates copied successfully');\"",
    "start": "node dist/server.js",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "prisma:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "prisma db seed",
    "seed:radar": "tsx prisma/seed-radar.ts",
    "smtp:verify": "tsx scripts/verify-smtp.ts",
    "supabase:verify": "tsx scripts/verify-supabase.ts",
    "supabase:setup": "tsx scripts/setup-supabase.ts",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@langchain/core": "^1.2.5",
    "@langchain/google": "^0.2.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@supabase/server": "^1.4.1",
    "@supabase/supabase-js": "^2.112.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/ngeohash": "^0.6.1",
    "@types/node": "^22.20.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@typesafe-ai/sdk": "^0.6.0",
    "@upstash/redis": "^1.38.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "firebase-admin": "^14.2.0",
    "googleapis": "^174.0.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nanoid": "^3.3.7",
    "ngeohash": "^0.6.4",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "redis": "^5.12.1",
    "socket.io": "^4.8.3",
    "stream-chat": "^9.50.2",
    "typescript": "^5.9.3",
    "zod": "^3.23.8"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
