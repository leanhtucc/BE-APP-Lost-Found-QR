{
  "name": "goalbe",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc && npm run copy-templates",
    "copy-templates": "node -e \"const fs=require('fs');const path=require('path');const src='src/templates';const dest='dist/templates';fs.cpSync(src,dest,{recursive:true});console.log('Templates copied successfully');\"",
    "start": "npx prisma migrate deploy && echo '>>> [SYSTEM] Starting Node...' && node dist/server.js",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "prisma:studio": "prisma studio",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/prettier": "^2.7.3",
    "prettier": "^3.7.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/ngeohash": "^0.6.1",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.14",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "firebase-admin": "^13.7.0",
    "googleapis": "^170.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "nanoid": "^3.3.7",
    "ngeohash": "^0.6.3",
    "nodemailer": "^6.9.8",
    "prisma": "^6.2.1",
    "redis": "^5.12.1",
    "resend": "^6.7.0",
    "socket.io": "^4.8.3",
    "stream-chat": "^9.28.0",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0",
    "zod": "^3.23.8"
  }
}
