generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(cuid())
  uid                    String    @unique
  memberId               String    @unique @default(cuid()) // Định danh người dùng toàn hệ thống
  displayName            String
  email                  String    @unique
  photoURL               String?
  pushToken              String?
  phoneNumber            String?

  // Trust & Reputation
  trustScore             Float     @default(5.0) // Mức độ uy tín (0-5)
  totalReturned          Int       @default(0)   // Số đồ đã trả
  itemsLost              Int       @default(0)   // Số đồ bị mất

  // Thông tin cá nhân mở rộng
  addressCity            String?   // Địa chỉ thành phố
  bio                    String?   // Tiểu sử

  // Xác thực
  isVerified             Boolean   @default(false) // Đánh dấu tài khoản đã xác minh

  // Cài đặt riêng tư (JSONB)
  privacySettings        Json?     @default("{}") // {"showPhone": true, "showEmail": false}

  // Auth fields
  password               String?
  verificationCode       String?
  verificationCodeExpiry DateTime?
  googleId               String?   @unique
  resetPasswordExpiry    DateTime?
  resetPasswordToken     String?
  lastLogin              DateTime?
  role                   String    @default("user")

  // Timestamps
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations
  ownedItems             Item[]    @relation("ItemOwner")

  @@index([uid])
  @@index([email])
  @@index([memberId])
  @@index([googleId])
  @@index([resetPasswordToken])
}

model Item {
  id               String   @id @default(cuid())
  itemId           String   @unique
  ownerId          String
  name             String
  category         String
  description      String?
  status           String   @default("safe")
  lostMessage      String?
  qrCodeUrl        String?
  securityToken    String   @unique
  latitude         Float?
  longitude        Float?
  locationGeoHash  String?  @map("location_geohash") @db.VarChar(16)
  location         Unsupported("geography(Point,4326)")?
  locationUpdatedAt DateTime? @map("location_updated_at")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  imagePublicUrl   String?
  lastSeenLocation String?
  securityPin      String?
  owner            User     @relation("ItemOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([ownerId])
  @@index([status])
  @@index([locationGeoHash], map: "Item_location_geohash_idx")
}
