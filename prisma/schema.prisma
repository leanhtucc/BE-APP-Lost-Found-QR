generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ItemStatus {
  SAFE
  LOST
  FOUND
  RESOLVED
}

enum GuardianReportStatus {
  PENDING_PAYMENT
  ACTIVE
  PAYMENT_FAILED
  CANCELLED
  EXPIRED
  FOUND
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum EscrowStatus {
  HOLDING
  RELEASED
  REFUNDED
}

enum PaymentProvider {
  VNPAY
  MOMO
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id          String  @id @default(cuid())
  uid         String  @unique
  memberId    String  @unique @default(cuid()) // Định danh người dùng toàn hệ thống
  displayName String
  email       String  @unique
  photoURL    String?
  pushToken   String?
  phoneNumber String?

  // Trust & Reputation
  trustScore    Float @default(5.0) // Mức độ uy tín (0-5)
  totalReturned Int   @default(0) // Số đồ đã trả
  itemsLost     Int   @default(0) // Số đồ bị mất

  // Thông tin cá nhân mở rộng
  addressCity String? // Địa chỉ thành phố
  bio         String? // Tiểu sử

  // Xác thực
  isVerified Boolean @default(false) // Đánh dấu tài khoản đã xác minh

  // Cài đặt riêng tư (JSONB)
  privacySettings Json? @default("{}") // {"showPhone": true, "showEmail": false}

  // Auth fields
  password               String?
  verificationCode       String?
  verificationCodeExpiry DateTime?
  googleId               String?   @unique
  resetPasswordExpiry    DateTime?
  resetPasswordToken     String?
  lastLogin              DateTime?
  role                   String    @default("user")
  tokenValidAfter        DateTime? @map("token_valid_after")
  tokenVersion           Int       @default(0) @map("token_version")
  deletionRequestedAt    DateTime? @map("deletion_requested_at")
  scheduledDeletionAt    DateTime? @map("scheduled_deletion_at")
  anonymizedAt           DateTime? @map("anonymized_at")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  ownedItems             Item[]                  @relation("ItemOwner")
  locations              UserLocation[]
  posts                  Post[]
  notifications          Notification[]
  aiConversations        AiConversation[]
  notificationPreference NotificationPreference?
  devices                UserDevice[]
  securityAuditLogs      SecurityAuditLog[]
  ownerReturnSessions    ReturnSession[]         @relation("ReturnSessionOwner")
  finderReturnSessions   ReturnSession[]         @relation("ReturnSessionFinder")
  ratingsGiven           FinderRatingRecord[]    @relation("RatingRater")
  ratingsReceived        FinderRatingRecord[]    @relation("RatingFinder")

  @@index([uid])
  @@index([email])
  @@index([memberId])
  @@index([googleId])
  @@index([resetPasswordToken])
  @@index([scheduledDeletionAt, anonymizedAt])
}

enum NotificationCategory {
  IMPORTANT
  TRANSACTION
  ITEM
  SOCIAL
}

model NotificationPreference {
  id                       String   @id @default(uuid())
  userId                   String   @unique @map("user_id")
  pushEnabled              Boolean  @default(true) @map("push_enabled")
  emailEnabled             Boolean  @default(false) @map("email_enabled")
  proximityEnabled         Boolean  @default(true) @map("proximity_enabled")
  notificationRadiusMeters Int      @default(3000) @map("notification_radius_meters")
  language                 String   @default("vi") @db.VarChar(5)
  importantEnabled         Boolean  @default(true) @map("important_enabled")
  transactionEnabled       Boolean  @default(true) @map("transaction_enabled")
  itemEnabled              Boolean  @default(true) @map("item_enabled")
  socialEnabled            Boolean  @default(true) @map("social_enabled")
  dailyDigestEnabled       Boolean  @default(true) @map("daily_digest_enabled")
  nearbyAlertsEnabled      Boolean  @default(true) @map("nearby_alerts_enabled")
  quietHoursEnabled        Boolean  @default(true) @map("quiet_hours_enabled")
  quietStart               String   @default("22:00") @map("quiet_start")
  quietEnd                 String   @default("07:00") @map("quiet_end")
  timezone                 String   @default("Asia/Ho_Chi_Minh")
  dailyDigestTime          String   @default("19:30") @map("daily_digest_time")
  nearbyRadius             Int      @default(3000) @map("nearby_radius")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UserDevice {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  token        String   @unique @map("push_token")
  platform     String   @default("android") @db.VarChar(20) // android, ios, web
  deviceId     String   @map("device_id") @db.VarChar(255)
  appVersion   String?  @map("app_version")
  lastActiveAt DateTime @default(now()) @map("last_seen_at")
  isActive     Boolean  @default(true) @map("enabled")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId, isActive])
  @@map("user_devices")
}

model SecurityAuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  action    String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("security_audit_logs")
}

model Notification {
  id             String               @id @default(cuid())
  receiverId     String               @map("receiver_id")
  category       NotificationCategory
  type           String
  title          String
  content        String
  metadata       Json?
  isRead         Boolean              @default(false) @map("is_read")
  dedupeKey      String?              @map("dedupe_key")
  scheduledAt    DateTime?            @map("scheduled_at")
  sentAt         DateTime?            @map("sent_at")
  openedAt       DateTime?            @map("opened_at")
  deliveryStatus String               @default("SENT") @map("delivery_status") // PENDING, SENT, FAILED, OPENED
  pushMessageId  String?              @map("push_message_id")
  createdAt      DateTime             @default(now()) @map("created_at")

  receiver User @relation(fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([receiverId, dedupeKey])
  @@index([receiverId, createdAt])
  @@index([receiverId, isRead])
  @@index([category])
  @@index([type])
  @@index([deliveryStatus])
}

model Item {
  id                String                                @id @default(cuid())
  itemId            String                                @unique @default(cuid())
  ownerId           String
  name              String
  category          String
  description       String?
  status            ItemStatus                            @default(SAFE)
  lostMessage       String?
  qrCodeUrl         String?
  securityToken     String                                @unique
  latitude          Float?
  longitude         Float?
  locationGeoHash   String?                               @map("location_geohash") @db.VarChar(16)
  location          Unsupported("geography(Point,4326)")?
  locationUpdatedAt DateTime?                             @map("location_updated_at")
  createdAt         DateTime                              @default(now())
  updatedAt         DateTime                              @updatedAt
  imagePublicUrl    String?
  lastSeenLocation  String?
  securityPin       String?
  // Guardian fields
  qrCodeId          String                                @unique @default(cuid()) @map("qr_code_id")
  details           Json? // {"color": "Titan Đen", "storage": "256GB", "serial": "48A..."}
  hasInsurance      Boolean                               @default(false) @map("has_insurance")
  // Lost item coordinates
  lostLat           Float?
  lostLng           Float?
  lostAddress       String?
  owner             User                                  @relation("ItemOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  posts             Post[]
  qrScans           QrScan[]
  returnSessions    ReturnSession[]

  @@index([itemId])
  @@index([ownerId])
  @@index([status])
  @@index([lostLat, lostLng])
  @@index([locationGeoHash], map: "Item_location_geohash_idx")
}

model QrScan {
  id        String   @id @default(uuid())
  itemId    String   @map("item_id")
  createdAt DateTime @default(now()) @map("created_at")

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
  @@map("qr_scans")
}

model UserLocation {
  userId    String   @id @map("user_id")
  lat       Float
  lng       Float
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lat, lng])
}

model Post {
  id                String               @id @default(cuid())
  ownerId           String               @map("owner_id")
  itemId            String               @map("item_id")
  lat               Float
  lng               Float
  address           String?
  bountyAmount      Int                  @map("bounty_amount")
  totalPaid         Int                  @default(0) @map("total_paid")
  // PENDING_PAYMENT → ACTIVE → FOUND → COMPLETED
  status            GuardianReportStatus @default(PENDING_PAYMENT)
  description       String?
  // Guardian Radar fields
  radarConfig       Json?                @map("radar_config") // {"radius": 500, "duration_hours": 24}
  normalizedAddress String?              @map("normalized_address")
  radarRadius       Int?                 @map("radar_radius")
  durationHours     Int?                 @map("duration_hours")
  serviceFee        Int                  @default(0) @map("service_fee")
  currency          String               @default("VND")
  activatedAt       DateTime?            @map("activated_at")
  expiresAt         DateTime?            @map("expires_at")
  idempotencyKey    String?              @unique @map("idempotency_key")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  item  Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  escrowTransactions EscrowTransaction[]
  payments           Payment[]
  returnSessions     ReturnSession[]

  @@index([ownerId])
  @@index([itemId])
  @@index([status])
  @@index([lat, lng])
  @@index([createdAt])
}

model Payment {
  id                    String          @id @default(cuid())
  reportId              String          @map("report_id")
  provider              PaymentProvider
  providerOrderId       String          @unique @map("provider_order_id")
  providerTransactionId String?         @unique @map("provider_transaction_id")
  status                PaymentStatus   @default(PENDING)
  amount                Int
  currency              String          @default("VND")
  paymentUrl            String          @map("payment_url")
  expiresAt             DateTime        @map("expires_at")
  paidAt                DateTime?       @map("paid_at")
  rawCallback           Json?           @map("raw_callback")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  report Post @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, status])
  @@index([expiresAt])
}

model EscrowTransaction {
  id              String          @id @default(cuid())
  postId          String          @map("post_id")
  amount          Int
  provider        PaymentProvider
  status          EscrowStatus    @default(HOLDING)
  transactionCode String?         @map("transaction_code")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([provider, transactionCode])
  @@index([postId])
  @@index([status])
}

model AiConversation {
  id        String      @id @default(cuid())
  userId    String      @map("user_id")
  title     String?
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([userId, updatedAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String         @map("conversation_id")
  role           AiMessageRole
  content        String
  inputTokens    Int?           @map("input_tokens")
  outputTokens   Int?           @map("output_tokens")
  metadata       Json?
  createdAt      DateTime       @default(now()) @map("created_at")
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum ReturnSessionStatus {
  CHAT_ACTIVE
  MEETUP_PROPOSED
  MEETUP_ACCEPTED
  TRACKING_ACTIVE
  ARRIVAL_PENDING
  HANDOVER_PENDING
  HANDOVER_CONFIRMED
  REWARD_RELEASING
  REWARD_PAID
  RATING_PENDING
  COMPLETED
  MEETUP_CANCELLED
  TRACKING_EXPIRED
  HANDOVER_DISPUTED
  PAYOUT_FAILED
  REFUND_PENDING
}

enum ReturnUserRole {
  OWNER
  FINDER
}

enum MeetupStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum RewardPayoutStatus {
  PROCESSING
  PAID
  FAILED
  ACTION_REQUIRED
}

model ReturnSession {
  id                String              @id @default(cuid())
  channelId         String              @unique @map("channel_id")
  itemId            String              @map("item_id")
  reportId          String?             @map("report_id")
  ownerId           String              @map("owner_id")
  finderId          String              @map("finder_id")
  status            ReturnSessionStatus @default(CHAT_ACTIVE)
  serverRevision    Int                 @default(1) @map("server_revision")
  trackingStartedAt DateTime?           @map("tracking_started_at")
  trackingExpiresAt DateTime?           @map("tracking_expires_at")
  completedAt       DateTime?           @map("completed_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  owner             User                @relation("ReturnSessionOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  finder            User                @relation("ReturnSessionFinder", fields: [finderId], references: [id], onDelete: Cascade)
  item              Item                @relation(fields: [itemId], references: [id], onDelete: Cascade)
  report            Post?               @relation(fields: [reportId], references: [id], onDelete: SetNull)

  meetupProposals       ReturnMeetupProposal[]
  arrivals              ReturnArrival[]
  handoverChallenge     HandoverChallenge?
  handoverConfirmations HandoverConfirmation[]
  rewardPayout          RewardPayoutRecord?
  rating                FinderRatingRecord?

  @@index([channelId])
  @@index([itemId])
  @@index([ownerId])
  @@index([finderId])
  @@index([status])
  @@map("return_sessions")
}

model ReturnMeetupProposal {
  id            String       @id @default(cuid())
  sessionId     String       @map("session_id")
  proposedBy    String       @map("proposed_by")
  address       String
  name          String?
  latitude      Float
  longitude     Float
  scheduledTime String       @map("scheduled_time")
  notes         String?
  status        MeetupStatus @default(PENDING)
  proposedAt    DateTime     @default(now()) @map("proposed_at")
  respondedAt   DateTime?    @map("responded_at")

  session       ReturnSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@map("return_meetup_proposals")
}

model ReturnArrival {
  id             String         @id @default(cuid())
  sessionId      String         @map("session_id")
  participantId  String         @map("participant_id")
  role           ReturnUserRole
  declaredAt     DateTime       @default(now()) @map("declared_at")
  latitude       Float?
  longitude      Float?
  distanceMeters Float?         @map("distance_meters")
  accuracy       Float?

  session        ReturnSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, participantId])
  @@index([sessionId])
  @@map("return_arrivals")
}

model HandoverChallenge {
  id               String        @id @default(cuid())
  sessionId        String        @unique @map("session_id")
  codeHash         String        @map("code_hash")
  expiresAt        DateTime      @map("expires_at")
  attemptCount     Int           @default(0) @map("attempt_count")
  maxAttempts      Int           @default(5) @map("max_attempts")
  consumedAt       DateTime?     @map("consumed_at")
  createdForUserId String        @map("created_for_user_id")
  createdAt        DateTime      @default(now()) @map("created_at")

  session          ReturnSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("handover_challenges")
}

model HandoverConfirmation {
  id                 String         @id @default(cuid())
  sessionId          String         @map("session_id")
  participantId      String         @map("participant_id")
  role               ReturnUserRole
  verificationMethod String         @default("CODE") @map("verification_method")
  idempotencyKey     String?        @map("idempotency_key")
  confirmedAt        DateTime       @default(now()) @map("confirmed_at")

  session            ReturnSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, participantId])
  @@index([sessionId])
  @@map("handover_confirmations")
}

model RewardPayoutRecord {
  id                  String             @id @default(cuid())
  sessionId           String             @unique @map("session_id")
  reportId            String?            @map("report_id")
  escrowTransactionId String?            @map("escrow_transaction_id")
  baseAmount          Int                @map("base_amount")
  platformFee         Int                @default(0) @map("platform_fee")
  netAmount           Int                @map("net_amount")
  currency            String             @default("VND")
  status              RewardPayoutStatus @default(PROCESSING)
  payoutMethodMasked  String?            @map("payout_method_masked")
  transactionId       String?            @map("transaction_id")
  failureReason       String?            @map("failure_reason")
  paidAt              DateTime?          @map("paid_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  session             ReturnSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("reward_payouts")
}

model FinderRatingRecord {
  id        String        @id @default(cuid())
  sessionId String        @unique @map("session_id")
  raterId   String        @map("rater_id")
  finderId  String        @map("finder_id")
  score     Int
  tags      String[]      @default([])
  comment   String?
  createdAt DateTime      @default(now()) @map("created_at")

  session   ReturnSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rater     User          @relation("RatingRater", fields: [raterId], references: [id], onDelete: Cascade)
  finder    User          @relation("RatingFinder", fields: [finderId], references: [id], onDelete: Cascade)

  @@index([finderId])
  @@map("finder_ratings")
}
