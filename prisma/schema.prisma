// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Collection: Users (Quản lý người dùng)
model User {
  id                     String    @id @default(cuid())
  uid                    String    @unique // ID từ Firebase Auth
  displayName            String
  email                  String    @unique
  password               String? // Hashed password (optional for OAuth users)
  photoURL               String?
  pushToken              String?
  totalReturned          Int       @default(0) // Số lần đã trả lại đồ
  isVerified             Boolean   @default(false) // Email đã xác thực chưa
  verificationCode       String? // Mã xác thực email
  verificationCodeExpiry DateTime? // Thời gian hết hạn mã xác thực
  googleId               String?   @unique // Google OAuth ID
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations
  ownedItems  Item[]    @relation("ItemOwner")
  ownedChats  Chat[]    @relation("ChatOwner")
  finderChats Chat[]    @relation("ChatFinder")
  messages    Message[]

  @@index([uid])
  @@index([email])
  @@index([googleId])
}

// Collection: Items (Quản lý đồ vật)
model Item {
  id               String   @id @default(cuid())
  itemId           String   @unique // ID ngẫu nhiên để dùng trong QR code
  ownerId          String
  name             String
  category         String // tech, pets, wallet, audio, etc.
  description      String?
  status           String   @default("safe") // safe hoặc lost
  lostMessage      String? // Lời nhắn khi bị mất
  qrCodeUrl        String? // Link QR code đầy đủ
  imagePublicUrl   String? // Link ảnh thật của món đồ
  lastSeenLocation String? // JSON string chứa lat/lng: {"lat": 10.123, "lng": 106.456}
  securityPin      String? // Mã PIN 4 số để xác nhận trả đồ
  securityToken    String   @unique // Token bảo mật cho QR code
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  owner User   @relation("ItemOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  chats Chat[]

  @@index([itemId])
  @@index([ownerId])
  @@index([status])
}

// Collection: Chats (Quản lý cuộc hội thoại)
model Chat {
  id          String   @id @default(cuid())
  chatId      String   @unique
  itemId      String
  ownerId     String
  finderId    String // ID người nhặt
  lastMessage String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  item     Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  owner    User      @relation("ChatOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  finder   User      @relation("ChatFinder", fields: [finderId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([chatId])
  @@index([itemId])
  @@index([ownerId])
  @@index([finderId])
}

// Sub-collection: Messages (Chi tiết từng tin nhắn)
model Message {
  id        String   @id @default(cuid())
  messageId String   @unique
  chatId    String
  senderId  String
  text      String?
  image     String? // URL ảnh nếu gửi ảnh
  location  String? // JSON string chứa lat/lng: {"lat": 10.123, "lng": 106.456}
  createdAt DateTime @default(now())

  // Relations
  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([chatId])
  @@index([senderId])
  @@index([createdAt])
}
