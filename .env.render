# Environment Variables cho Render.com
# Copy toàn bộ các biến này vào Render Dashboard → Environment

# ==========================================
# REQUIRED - BẮT BUỘC PHẢI CÓ
# ==========================================

NODE_ENV=production
PORT=3000
API_PREFIX=/api

# Database URL - LẤY TỪ RENDER POSTGRESQL SERVICE
# Format: postgresql://user:password@hostname/database
DATABASE_URL=postgresql://backend_user:CHANGE_ME@dpg-xxx.oregon-postgres.render.com/backend_db

# JWT Secrets - GENERATE TẠI: https://generate-secret.now.sh/32
JWT_SECRET=CHANGE-ME-32-CHARACTERS-MINIMUM-SECRET-KEY
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE-ME-ANOTHER-32-CHARS-REFRESH-KEY
JWT_REFRESH_EXPIRES_IN=30d

# Email SMTP - GMAIL APP PASSWORD
# Setup: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Your App Name
SKIP_EMAIL_VERIFICATION=false

# Stream Chat API - GET FROM: https://getstream.io
STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret

# App Base URL - SẼ LÀ: https://your-app-name.onrender.com
APP_BASE_URL=https://your-app.onrender.com

# ==========================================
# OPTIONAL - TÙY CHỌN (Nếu dùng Google OAuth)
# ==========================================

# Google OAuth - GET FROM: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-app.onrender.com/api/auth/google/callback

# ==========================================
# REDIS - CHỈ NẾU BẠN SETUP REDIS RIÊNG
# ==========================================
# REDIS_URL=redis://username:password@redis-host:6379


# ==========================================
# 📝 HƯỚNG DẪN NHANH
# ==========================================
#
# 1. THAY THẾ GIÁ TRỊ:
#    - DATABASE_URL: Lấy từ Render PostgreSQL service (Internal URL)
#    - JWT_SECRET & JWT_REFRESH_SECRET: Generate tại https://generate-secret.now.sh/32
#    - SMTP_USER & SMTP_PASS: Lấy từ Gmail App Passwords
#    - STREAM_API_KEY & STREAM_API_SECRET: Lấy từ getstream.io
#    - APP_BASE_URL: URL của app trên Render (https://your-app.onrender.com)
#
# 2. COPY VÀO RENDER:
#    - Vào Render Dashboard → Chọn Web Service
#    - Tab "Environment"
#    - Click "Add Environment Variable"
#    - Paste từng dòng (Key = Value)
#
# 3. SAU KHI THÊM:
#    - Click "Save Changes"
#    - Render sẽ tự động redeploy
#
# ==========================================
# ⚠️ LƯU Ý QUAN TRỌNG
# ==========================================
#
# - KHÔNG commit file này với giá trị thật vào Git
# - Database URL phải dùng "Internal URL" từ Render (không phải External)
# - JWT secrets phải ít nhất 32 ký tự
# - Gmail SMTP_PASS phải là App Password (16 ký tự), không phải mật khẩu thường
# - APP_BASE_URL phải update sau khi deploy xong (lúc đầu để tạm localhost)
#
