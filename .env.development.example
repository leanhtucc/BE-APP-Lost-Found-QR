# Copy to .env.development.local. That file is ignored by Git.
# Run Node/Prisma with DOTENV_CONFIG_PATH=.env.development.local.
NODE_ENV=development
PORT=3001
API_PREFIX=/api
DATABASE_URL="postgresql://findback_dev:CHANGE_ME@localhost:5433/lostfound_dev"
DIRECT_URL="postgresql://findback_dev:CHANGE_ME@localhost:5433/lostfound_dev"
# Keep false/omitted for the Phase 1 local PostGIS workflow. Remote dev/test
# targets are blocked unless this is deliberately set to true.
ALLOW_REMOTE_NON_PRODUCTION_DATABASE=false
JWT_SECRET="replace-with-a-local-secret-at-least-16-characters"
JWT_REFRESH_SECRET="replace-with-a-different-local-secret-at-least-16-characters"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="30d"
SKIP_EMAIL_VERIFICATION=true
APP_URL="http://localhost:3001"
APP_BASE_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:19006"
CORS_ORIGINS="http://localhost:19006,http://localhost:3001"
